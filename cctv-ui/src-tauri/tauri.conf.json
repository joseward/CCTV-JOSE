{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cctv-viewer",
  "version": "1.1.5",
  "identifier": "com.cctv.unified.monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCTV Unified Monitor - Security Operations Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": true,
        "additionalBrowserArgs": "--enable-features=WebRtcAllowH265,PlatformHEVCDecoderSupport --enable-clear-hevc-for-testing --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "bin/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installerHooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1RTczNjkzQzI2RkRFMTgKUldRWTNtL0NremJuTmJTcUlGY0tCODFlN2VXcmF0Vk5uenJjc0tFeVA4WlpWZkkxZXZSdkJ6SUsK",
      "endpoints": [
        "https://github.com/joseward/CCTV-JOSE/releases/latest/download/latest.json"
      ]
    }
  }
}
